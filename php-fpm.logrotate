/var/log/php-fpm/php-fpm.log /var/log/php-fpm/php-fpm-slow.log {
    rotate 5
    monthly
    missingok
    create 640 www www
    notifempty
    nocompress
    postrotate
	/usr/bin/systemctl kill --kill-whom=main --signal=USR1 php-fpm.service 'php-fpm@*.service' >/dev/null 2>&1 || :
    endscript
}
